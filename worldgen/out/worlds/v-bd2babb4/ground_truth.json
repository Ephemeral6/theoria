  "rules": [
    {
      "name": "walk",
      "reversible": "conditional \u2014 reversible on open floor, not across a one-way edge",
      "then": "the agent moves one cell in direction D",
      "when": "act=D and the target cell is inside the grid, is not a wall, and no mechanism claims it"
    },
    {
      "name": "blocked_by_wall",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell is outside the grid or is a wall"
    },
    {
      "name": "walk_through_cycler",
      "reversible": true,
      "then": "the agent enters the cell and the phase does not change",
      "when": "act=D and the target cell holds a cycler whose phase equals its open phase"
    },
    {
      "name": "advance_cycler",
      "re_witnessable": "conditional \u2014 the advance fires only from a shut phase, so a second witness needs a route that returns the agent to one; measured per world",
      "reversible": true,
      "then": "the agent does not move and the cycler's phase becomes (phase + 1) mod k",
      "when": "act=D and the target cell holds a cycler whose phase is not its open phase"
    },
    {
      "name": "teleport_twoway",
      "reversible": true,
      "then": "the agent is placed on the other mouth, independently of D",
      "when": "act=D and the target cell holds one mouth of a two-way pair and the other mouth is free"
    },
    {
      "clause": true,
      "name": "blocked_portal_exit",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell holds a portal whose landing cell is a wall, out of bounds, or occupied"
    },
    {
      "name": "collect_token",
      "re_witnessable": true,
      "reversible": false,
      "then": "that token becomes collected \u2014 it stops being drawn and the global collected count rises by one \u2014 and the agent takes its cell",
      "when": "act=D and the target cell holds an uncollected token",
      "why": "one witness per token, so the count is the number of tokens \u2014 2 here"
    },
    {
      "name": "walk_through_lock",
      "reversible": true,
      "then": "the agent moves onto the lock's cell",
      "when": "act=D and the target cell holds a lock whose k is at most the global number of tokens collected so far \u2014 the count is shared by every lock, not kept per lock"
    },
    {
      "name": "blocked_by_lock",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell holds a lock whose k exceeds the global number of tokens collected so far"
    }
  ],
