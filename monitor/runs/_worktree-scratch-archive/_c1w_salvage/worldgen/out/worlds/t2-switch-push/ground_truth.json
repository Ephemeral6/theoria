    {
      "name": "push",
      "reversible": "conditional \u2014 only where the agent can reach the far side of the block",
      "then": "the block moves one cell in direction D and the agent takes the block's old cell",
      "when": "act=D and the target cell holds a block and the cell beyond it in direction D is free"
    },
    {
      "name": "blocked_by_block",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell holds a block and the cell beyond it is not free"
    },
    {
      "name": "toggle_switch",
      "reversible": true,
      "then": "that switch's bit flips 0\u21941 and the agent stays where it is",
      "when": "act=D and the target cell holds a switch in toggle mode"
    },
    {
      "name": "walk_through_door",
      "reversible": true,
      "then": "the agent enters the door's cell",
