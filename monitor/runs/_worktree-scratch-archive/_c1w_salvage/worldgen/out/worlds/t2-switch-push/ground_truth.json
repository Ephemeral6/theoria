      "name": "blocked_by_door",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell holds a door whose net's aggregate bit does not match its polarity"
    },
    {
      "name": "door_mirrors_net",
      "reversible": true,
      "then": "N is on iff any switch on N shows 1 (an OR network); the door is passable and undrawn iff N's aggregate bit matches P, and impassable and drawn otherwise",
