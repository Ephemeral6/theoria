+            "(1@0 + 1@1 + 1@3 + 1@4 + 1@6 + 1@7 + 1@9 + 1@10 + 1@12) mod 2 = 0"
+          ],
+          "separates_initial_from_goal": true,
+          "n_separating_vectors_in_span": 16384
