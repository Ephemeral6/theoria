  "rules": [
    {
      "name": "walk",
      "reversible": "conditional \u2014 reversible on open floor, not across a one-way edge",
      "then": "the agent moves one cell in direction D",
      "when": "act=D and the target cell is inside the grid, is not a wall, and no mechanism claims it"
    },
    {
      "name": "blocked_by_wall",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell is outside the grid or is a wall"
    },
    {
      "name": "press_latch",
      "reversible": false,
      "then": "that switch's bit becomes 1, permanently, and the agent stays where it is",
      "when": "act=D and the target cell holds a switch in latch mode whose bit is 0"
    },
    {
      "clause": true,
      "name": "latch_already_set",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell holds a switch in latch mode whose bit is already 1"
    },
    {
      "clause": true,
      "name": "blocked_toggle_would_shut_door",
      "reversible": true,
      "then": "nothing changes \u2014 the switch visibly refuses to flip",
      "when": "act=D and the target cell holds a switch whose flip would leave the door the agent is standing on impassable",
      "why": "without it the agent ends up inside a solid cell, the door's own `door_presence_tracks_net` invariant fails, and the agent (painted last) erases the closed door's colour, so two states render alike"
    },
    {
      "name": "walk_through_door",
      "reversible": true,
      "then": "the agent enters the door's cell",
      "when": "act=D and the target cell holds a door whose net's aggregate bit matches its polarity"
    },
    {
      "clause": true,
      "name": "blocked_by_door",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell holds a door whose net's aggregate bit does not match its polarity"
    },
    {
      "cascade": true,
      "name": "door_mirrors_net",
      "reversible": true,
      "then": "N is on iff any switch on N shows 1 (an OR network); the door is passable and undrawn iff N's aggregate bit matches P, and impassable and drawn otherwise",
      "when": "at every instant, for a door on net N with polarity P"
    },
    {
      "name": "collect_token",
      "re_witnessable": true,
      "reversible": false,
      "then": "that token becomes collected \u2014 it stops being drawn and the global collected count rises by one \u2014 and the agent takes its cell",
      "when": "act=D and the target cell holds an uncollected token",
      "why": "one witness per token, so the count is the number of tokens \u2014 3 here"
    },
    {
      "name": "walk_through_lock",
      "reversible": true,
      "then": "the agent moves onto the lock's cell",
      "when": "act=D and the target cell holds a lock whose k is at most the global number of tokens collected so far \u2014 the count is shared by every lock, not kept per lock"
    },
    {
      "name": "blocked_by_lock",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell holds a lock whose k exceeds the global number of tokens collected so far"
    },
    {
      "name": "cross_fragile",
      "re_witnessable": false,
      "reversible": false,
      "then": "the agent moves onto the tile and the tile arms.  The tile does not collapse on this step: the collapse happens later, in settlement, on the first step at which the agent is no longer standing there \u2014 so in the trace the tile changes to the collapsed colour one frame after the crossing, not in the frame of the crossing itself",
      "when": "act=D and the target cell holds an intact fragile tile",
      "why": "one witness per tile, so the count is the number of tiles \u2014 1 here"
    },
    {
      "clause": true,
      "name": "blocked_by_collapsed",
      "reversible": true,
      "then": "nothing changes",
      "when": "act=D and the target cell holds a collapsed fragile tile"
    }
  ],
